# ==============================================================================
# AGRIDIRECT Backend — Production Environment Variables Reference
# ==============================================================================

# Server Runtime Configuration
PORT=5000
NODE_ENV=production

# ------------------------------------------------------------------------------
# 1. FRONTEND ORIGIN & CORS (GitHub Pages)
# ------------------------------------------------------------------------------
# Set this to your GitHub Pages base URL (without trailing slash)
# Example: https://<your-github-username>.github.io
CLIENT_URL=https://shaikroshan.github.io

# Additional comma-separated origins if you have custom domains
ALLOWED_ORIGINS=https://shaikroshan.github.io,http://localhost:5173

# ------------------------------------------------------------------------------
# 2. FIREBASE ADMIN SDK CREDENTIALS (Authentication, Firestore, Cloud Storage)
# ------------------------------------------------------------------------------
# You have TWO options to supply your Firebase Service Account in production:
#
# OPTION A (RECOMMENDED FOR CLOUD HOSTS: Render / Railway / Fly.io):
# Paste the entire content of serviceAccountKey.json as a raw JSON string:
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk@...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# OPTION B (INDIVIDUAL ENVIRONMENT VARIABLES):
FIREBASE_PROJECT_ID=agridirect-platform
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@agridirect-platform.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC7...\n-----END PRIVATE KEY-----\n"

# Cloud Storage Bucket (Found in Firebase Console -> Storage)
FIREBASE_STORAGE_BUCKET=agridirect-platform.appspot.com

# ------------------------------------------------------------------------------
# 3. AI & LOGISTICS (Optional external APIs)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
